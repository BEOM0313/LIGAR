# 공공데이터포털 '일반 인증키'를 넣으세요. Encoding 키(%2B…)와 Decoding 키(+/=) 모두 됩니다.
# 이 파일을 .env로 복사해 쓰고, .env는 절대 Git에 올리지 마세요.
DATA_GO_KR_KEY=여기에_인증키
PORT=8080
# 기능별 하루 호출 상한 (개발계정 1,000건 → 여유를 두고 950)
DAILY_LIMIT=950
# 1이면 키가 있어도 가상 데이터로 동작
DEMO=0
# '지금 여기 응급실' MCP 서버 주소 (문 연 병·의원 · 약국 · 의약품 정보). off 로 두면 연동하지 않음
HERE_NOW_ER_MCP_URL=http://210.109.60.53/mcp
